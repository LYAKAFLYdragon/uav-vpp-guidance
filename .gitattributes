# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# The P4 evidence bundle is an immutable byte-level record.  Do not normalize
# line endings in its copied JSON/YAML inputs, or its manifest hashes break.
/reports/p4_evidence_bundle_20260714/** -text

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.pt binary
*.pth binary
*.mat binary
*.acmi binary
